# Copy to .env and fill in. Never commit .env. Never put an API key here:
# every EXPO_PUBLIC_ value is bundled into the app and readable by anyone.

# FastAPI backend. On a phone, localhost is the phone: use the Mac's LAN IP
# (http://192.168.x.x:8000) or the backend's ngrok https URL.
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000

# Hosted share site (Phase 5). The QR code encodes this + /share/<session_id>.
EXPO_PUBLIC_SHARE_BASE_URL=
