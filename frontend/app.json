{
  "expo": {
    "name": "TrailSense",
    "slug": "trailsense",
    "version": "0.1.0",
    "scheme": "trailsense",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "TrailSense uses the camera to preview the trail and detect hazards.",
          "microphonePermission": "TrailSense uses audio to help assess live fall clips.",
          "recordAudioAndroid": true
        }
      ]
    ],
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "edgeToEdgeEnabled": true
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
