{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "lib/api.ts",
    "lib/schema.ts",
    "lib/format.ts",
    "lib/session.ts",
    "expo-env.d.ts",
    ".expo/types/**/*.ts"
  ]
}
