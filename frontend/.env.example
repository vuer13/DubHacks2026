# On a physical phone, replace localhost with your Mac's Wi-Fi IP address.
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000

# SOS fallback location, used only when the phone has no live or last known fix.
# Every EXPO_PUBLIC_ value is bundled into the app, so never put a key here.
EXPO_PUBLIC_DEMO_LAT=49.3
EXPO_PUBLIC_DEMO_LNG=-123.1

# Shown as "Call emergency contact" when an SOS keeps failing. Leave empty to hide the button.
# Digits with an optional leading +, for example +16045551234.
EXPO_PUBLIC_EMERGENCY_CONTACT_PHONE=
